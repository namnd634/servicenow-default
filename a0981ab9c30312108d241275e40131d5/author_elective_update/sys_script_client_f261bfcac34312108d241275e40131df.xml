        <name>Mandetory fields for Helpdesk</name>
        <order/>
        <script><![CDATA[function onLoad(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    // Kiểm tra vai trò của người dùng
    var userRoles = g_user.roles; // Lấy danh sách các vai trò của người dùng
    var isHelpdesk = userRoles.includes('nam-helpdesk'); // Thay 'itil' bằng role cụ thể của Helpdesk nếu khác

    // Đặt Assignment Group là mandatory nếu người dùng thuộc vai trò Helpdesk
    if (isHelpdesk) {
        g_form.setMandatory('u_assignment_group', true);
    }
}
]]></script>
